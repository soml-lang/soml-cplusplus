set(required_options)
if(COMPILER_ID STREQUAL "GNU")
	list(APPEND required_options -freflection)
endif()
if(REQUIRE_SANITIZERS)
	list(APPEND required_options -fsanitize=address,undefined -fno-sanitize-recover=all -fno-omit-frame-pointer)
endif()
foreach(target MODULE TEST)
	foreach(option IN LISTS required_options)
		if(NOT option IN_LIST ${target}_COMPILE_OPTIONS)
			message(FATAL_ERROR "The ${target} target is missing required compiler option: ${option}")
		endif()
	endforeach()
endforeach()
